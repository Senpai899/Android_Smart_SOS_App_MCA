<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme (Light Mode) -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/sos_red</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/sos_light_red</item>
        <item name="colorOnPrimaryContainer">@color/sos_dark_red</item>
        <item name="colorSecondary">@color/sos_blue</item>
        <item name="android:windowBackground">@color/background_app</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="dialogTheme">@style/CustomAlertDialogTheme</item>
        <item name="android:statusBarColor">@color/header_bg_start</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.MyApplication" parent="Base.Theme.MyApplication" />

    <style name="CustomAlertDialogTheme" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/dialog_bg</item>
        <item name="colorSurface">@color/dialog_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
    </style>
</resources>