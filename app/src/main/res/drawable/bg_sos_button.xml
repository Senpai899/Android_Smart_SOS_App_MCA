<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/sos_red_ripple">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:endColor="@color/sos_dark_red"
                android:startColor="@color/sos_red"
                android:type="linear" />
            <size
                android:width="190dp"
                android:height="190dp" />
            <stroke
                android:width="4dp"
                android:color="#FF8A80" />
        </shape>
    </item>
</ripple>