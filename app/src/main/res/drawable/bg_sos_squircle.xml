<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/sos_red_ripple">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#FF3B30"
                android:centerColor="#D32F2F"
                android:endColor="#A71217"
                android:type="linear" />
            <corners android:radius="46dp" />
            <stroke
                android:width="2dp"
                android:color="#FF8A80" />
        </shape>
    </item>
</ripple>